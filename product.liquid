<div data-product-tabs>
  <nav>
    <button class="active" data-tab="info">ΠΛΗΡΟΦΟΡΙΕΣ</button>
    <button data-tab="description">ΠΕΡΙΓΡΑΦΗ</button>
    <button data-tab="ingredients">ΣΥΣΤΑΤΙΚΑ</button>
    <button data-tab="dosologia">ΟΔΗΓΙΕΣ &amp; ΔΟΣΟΛΟΓΙΑ</button>
    <button data-tab="reviews">ΑΞΙΟΛΟΓΗΣΕΙΣ</button>
  </nav>

  <div class="tab-content">
    <div data-panel="info">
      <div class="product-info-content">
        <h1>{{ product.title }}</h1>

        {% render 'reminder' %}

        {% if product.metafields.custom.info_text != blank %}
          {{ product.metafields.custom.info_text | metafield_tag }}
        {% elsif product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>Περιγραφή προϊόντος δεν είναι διαθέσιμη.</p>
        {% endif %}

        {% assign recommended_for = product.metafields.custom.recommended_for %}
        {% if recommended_for != blank %}
          <h2>Για Ποιους Σκύλους Προτείνεται</h2>
          {{ recommended_for | metafield_tag }}
        {% endif %}

        {% assign functional_benefits = product.metafields.custom.functional_benefits %}
        {% if functional_benefits != blank %}
          <h2>Λειτουργικά συστατικά &amp; οφέλη</h2>
          {{ functional_benefits | metafield_tag }}
        {% endif %}
      </div>
    </div>

    <div data-panel="description" hidden>
      <div class="product-info-content">
        {% if product.metafields.custom.description_text != blank %}
          {{ product.metafields.custom.description_text | metafield_tag }}
        {% elsif product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>Περιγραφή προϊόντος δεν είναι διαθέσιμη.</p>
        {% endif %}
      </div>
    </div>

    <div data-panel="ingredients" hidden>
      {% if product.metafields.custom.product_composition != blank %}
        <div class="ingredients-copy">
          <strong>Σύνθεση:</strong>
          {{ product.metafields.custom.product_composition | metafield_tag }}
        </div>
      {% endif %}

      {% if product.metafields.custom.systatika != blank %}
        {{ product.metafields.custom.systatika | metafield_tag }}
      {% endif %}

      {% assign nutrition_data = product.metafields.custom.nutrition.value %}
      {% if nutrition_data != blank %}
        <section class="nutrition-analysis">
          <h3>Διατροφική Ανάλυση</h3>

          {% for item in nutrition_data %}
            {% assign value = item.value | plus: 0 %}
            {% if value < 0 %}
              {% assign value = 0 %}
            {% endif %}
            {% if value > 100 %}
              {% assign value = 100 %}
            {% endif %}

            <div class="nutrition-row">
              <div class="nutrition-label" style="font-size: 1.12rem; line-height: 1.5;">
                <span style="font-size: inherit;">{{ item.label }}</span>
                <strong style="font-size: inherit;">{{ item.value }}%</strong>
              </div>
              <div class="nutrition-bar" style="height: 34px;">
                <span style="width: {{ value }}%; font-size: 12px;">{{ item.value }}%</span>
              </div>
            </div>
          {% endfor %}
        </section>
      {% endif %}

      {% assign ingredient_meta = '' %}
      {% if product.metafields.custom.prostheta_ana_kilo != blank or product.metafields.custom.thermides != blank %}
        <div class="info-grid">
          {% if product.metafields.custom.prostheta_ana_kilo != blank %}
            <div class="info-card" style="font-size: 1.1rem; line-height: 1.8;">
              <strong style="font-size: 1.2rem;">Πρόσθετα ανά Κιλό:</strong>
              <p style="font-size: 1.08rem; line-height: 1.8; margin: 0;">{{ product.metafields.custom.prostheta_ana_kilo }}</p>
            </div>
          {% endif %}

          {% if product.metafields.custom.thermides != blank %}
            <div class="info-card" style="font-size: 1.1rem; line-height: 1.8;">
              <strong style="font-size: 1.2rem;">Θερμίδες:</strong>
              <p style="font-size: 1.08rem; line-height: 1.8; margin: 0;">{{ product.metafields.custom.thermides }}</p>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div data-panel="dosologia" hidden>
      {% if product.metafields.custom.dosologia_text != blank %}
        {{ product.metafields.custom.dosologia_text | metafield_tag }}
      {% endif %}

      {% assign rows = product.metafields.custom.dosologia_table.value %}
      {% if rows != blank %}
        <table class="dosologia-table">
          <thead>
            <tr>
              <th>ΒΑΡΟΣ ΣΚΥΛΟΥ (ΣΕ ΚΙΛΑ)</th>
              <th>ΗΜΕΡΗΣΙΑ ΠΟΣΟΤΗΤΑ ΤΡΟΦΗΣ (ΣΕ ΓΡΑΜΜΑΡΙΑ)</th>
              <th>ΣΥΝΔΥΑΣΜΟΣ ΞΗΡΟ / ΥΓΡΟ (ΣΕ ΓΡΑΜΜΑΡΙΑ)</th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
              <tr>
                <td>{{ row.weight }}</td>
                <td>{{ row.amount }}</td>
                <td>{{ row.combo }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>

    <div data-panel="reviews" hidden></div>
  </div>
</div>

<style>
  [data-product-tabs] {
    --tab-bg: #ffffff;
    --tab-border: #ffffff;
    --tab-text: #1d1d1d;
    --tab-active: #1a1a1a;
    --tab-accent: #7aa45d;
    --panel-bg: #ffffff;
    --table-bg: #6d7d59;
    --table-text: #ffffff;
  }

  [data-product-tabs] nav {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    white-space: nowrap;
    border-bottom: 1px solid var(--tab-border);
    background: var(--tab-bg);
    padding: 0 12px;
    scrollbar-width: thin;
  }

  [data-product-tabs] button {
    background: transparent;
    border: 0;
    border-bottom: 3px solid transparent;
    color: var(--tab-text);
    font: 600 13px/1.2 "Arial", sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 18px 4px 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  [data-product-tabs] button.active {
    border-bottom-color: var(--tab-active);
    color: var(--tab-active);
    font-weight: 700;
  }

  .tab-content {
    padding-top: 24px;
  }

  [data-panel][hidden] {
    display: none !important;
  }

  [data-panel] {
    color: #1d1d1d;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
  }

  .product-info-content {
    max-width: 100%;
  }

  .product-info-content h1,
  .product-info-content h2,
  .product-info-content h3,
  .product-info-content h4 {
    margin: 0 0 16px;
    color: #1d1d1d;
    font-weight: 700;
    line-height: 1.25;
  }

  .product-info-content h1 {
    font-size: 2.05rem;
    margin-bottom: 18px;
  }

  .product-info-content h2 {
    font-size: 1.4rem;
    margin-top: 20px;
    margin-bottom: 10px;
  }

  .product-info-content p {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.7;
    color: #1d1d1d;
  }

  .product-info-content ul,
  .product-info-content ol {
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
  }

  .product-info-content li {
    position: relative;
    margin: 0 0 10px;
    padding-left: 26px;
    font-size: 13px;
    line-height: 1.6;
    color: #1d1d1d;
  }

  .product-info-content li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: #2e6d32;
    font-weight: 700;
    font-size: 13px;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 10px 0 26px;
  }

  .benefits-list li {
    padding-left: 24px;
    margin-bottom: 8px;
  }

  .benefits-list li::before {
    color: #2e6d32;
  }

  .benefits-list-stars li::before {
    content: "★";
    color: #2e6d32;
    font-size: 12px;
    top: 1px;
  }

  .ingredients-copy {
    margin: 0 0 18px;
    padding: 14px 16px;
    background: #ffffff;
    border: 1px solid #ffffff;
    border-radius: 10px;
    line-height: 1.7;
    color: var(--tab-text);
  }

  .ingredients-copy strong {
    display: inline-block;
    margin-bottom: 6px;
    font-weight: 700;
  }

  .ingredients-copy p {
    margin: 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 18px 0;
  }

  .info-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    background: #ffffff;
    border: 1px solid #ffffff;
    border-radius: 10px;
  }

  .info-card strong {
    font-size: 1.02rem !important;
    font-weight: 700;
    color: var(--tab-text);
    margin: 0;
  }

  .info-card p {
    margin: 0;
    font-size: 1rem !important;
    line-height: 1.7;
    color: var(--tab-text);
  }

  [data-product-tabs] .nutrition-analysis {
    display: grid;
    gap: 16px;
    margin-top: 12px;
    padding: 18px 0;
    font-size: 17px !important;
  }

  [data-product-tabs] .nutrition-analysis h3 {
    margin: 0;
    font-size: 1.25rem !important;
    font-weight: 700;
    color: var(--tab-text);
  }

  [data-product-tabs] .nutrition-row {
    display: grid;
    gap: 8px;
  }

  [data-product-tabs] .nutrition-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1rem !important;
    line-height: 1.5;
    color: var(--tab-text);
  }

  [data-product-tabs] .nutrition-label strong {
    font-weight: 700;
    font-size: 1rem !important;
  }

  [data-product-tabs] .nutrition-bar {
    height: 32px;
    background: #ece7df;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid #ddd2c3;
  }

  [data-product-tabs] .nutrition-bar span {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 42px;
    height: 100%;
    padding: 0 10px;
    box-sizing: border-box;
    background: linear-gradient(90deg, #7aa45d 0%, #5d8940 100%);
    color: #fff;
    font-size: 12px !important;
    font-weight: 700;
    border-radius: 999px;
  }

  @media (min-width: 768px) {
    [data-product-tabs] .nutrition-label,
    [data-product-tabs] .nutrition-label strong {
      font-size: 1.08rem !important;
    }

    [data-product-tabs] .nutrition-bar {
      height: 36px;
    }

    [data-product-tabs] .nutrition-bar span {
      font-size: 13px !important;
    }
  }

  .dosologia-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--table-bg);
    color: var(--table-text);
    text-align: center;
    border-radius: 12px;
    overflow: hidden;
  }

  .dosologia-table thead {
    background: rgba(0, 0, 0, 0.08);
  }

  .dosologia-table th,
  .dosologia-table td {
    padding: 14px 12px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.8rem;
    vertical-align: middle;
  }

  .dosologia-table th {
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .product-trust-bar {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-bottom: 14px;
    }

    .trust-item {
      justify-content: flex-start;
    }

    [data-product-tabs] nav {
      gap: 12px;
    }

    [data-product-tabs] button {
      font-size: 11px;
      letter-spacing: 0.05em;
      padding-top: 16px;
    }
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-product-tabs]').forEach(function (root) {
      var tabs = root.querySelectorAll('[data-tab]');
      var panels = root.querySelectorAll('[data-panel]');

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) {
            t.classList.toggle('active', t === tab);
          });

          panels.forEach(function (panel) {
            var target = tab.getAttribute('data-tab');
            panel.hidden = panel.getAttribute('data-panel') !== target;
          });
        });
      });
    });
  })();
</script>